{
  "_comment": "Paste this snippet into opencode.json > mcp.redmine. Verified against @onozaty/redmine-mcp-server 1.2.0 (2026-09).",
  "redmine": {
    "type": "local",
    "command": ["npx", "-y", "@onozaty/redmine-mcp-server"],
    "environment": {
      "REDMINE_URL": "{env:REDMINE_URL}",
      "REDMINE_API_KEY": "{env:REDMINE_API_KEY}",
      "REDMINE_MCP_READ_ONLY": "{env:REDMINE_MCP_READ_ONLY}"
    },
    "enabled": true
  }
}
