# =============================================================================
# AI Engineering — Environment Template
# Copy to .env and fill in values. Never commit .env.
# =============================================================================

# --- Dify Knowledge API ---
# Base URL of your Dify instance (self-hosted or cloud).
# Cloud: https://api.dify.ai/v1
# Self-hosted: https://dify.your-company.com/v1  (must end with /v1)
DIFY_BASE_URL=https://api.dify.ai/v1

# Dataset (Knowledge Base) API key — create at Dify Console > Knowledge > Service API
# A single key can access every knowledge base visible to the account that created it.
DIFY_API_KEY=dataset-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: comma-separated list of dataset IDs visible by default.
# Find IDs at Dify Console URL: /datasets/<id>  or via list_knowledge_bases tool.
# If empty, search_knowledge will search across all accessible bases.
# DIFY_DATASET_IDS=abc123-def456-...,ghi789-jkl012-...

# --- Redmine ---
REDMINE_URL=https://redmine.your-company.com
REDMINE_API_KEY=your-redmine-api-key-here
# Set to "true" to enforce read-only mode (recommended for AI agents).
REDMINE_MCP_READ_ONLY=true
# Optional: regex to filter exposed tools (e.g. "^(get|list|search)_" for read-only subset)
# REDMINE_MCP_TOOL_FILTER=

# --- LLM Providers (at least one required) ---
# Anthropic
ANTHROPIC_API_KEY=
# OpenAI (also compatible with OpenAI-compatible gateways)
OPENAI_API_KEY=
# Any other provider supported by OpenCode (75+ via Models.dev)
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# --- Optional: OpenCode / Oh My OpenAgent ---
# Override default model (format: provider/model-id)
# OPENCODE_MODEL=anthropic/claude-sonnet-4-5
# OPENCODE_SMALL_MODEL=anthropic/claude-haiku-4-5
